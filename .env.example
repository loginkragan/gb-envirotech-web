# ========================================================
# GB ENVIROTECH - Backend Configuration & Environment Variables
# ========================================================

# Port to run the server on (default: 3000)
PORT=3000

# Security Key / Password for the /admin Lead CRM Portal
ADMIN_PASSWORD=GBEnviro@2026

# Email Notifications (Nodemailer SMTP Configuration)
# When configured, instant lead alerts are dispatched to your team inbox.
# Leave blank to operate in local log mode (leads are always saved to data/leads.json).
NOTIFICATION_EMAIL=info@gbenvirotech.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
